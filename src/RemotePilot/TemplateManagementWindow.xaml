<Window x:Class="RemotePilot.TemplateManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemotePilot"
        Title="{DynamicResource {x:Static local:TemplateManagementWindow.ResWinTitle}}" 
        Height="600" Width="900" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResHeader}}" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：模板列表 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,8,8,6">
                        <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResTemplateList}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,150,0"/>
                        <ComboBox x:Name="CmbTemplateSort" Width="130" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="CmbTemplateSort_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResSortByName}}"/>
                            <ComboBoxItem Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResSortByUsage}}"/>
                        </ComboBox>
                    </Grid>
                    <ListBox x:Name="LstTemplates" Grid.Row="1" 
                             SelectionMode="Single" 
                             SelectionChanged="LstTemplates_SelectionChanged"
                             Margin="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding UsageText}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource MutedForeground}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- 右侧：详情面板 -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="4,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelDetails" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResDetailTitle}}" 
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResFldName}}" 
                                       VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtDetailName" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResFldProtocol}}" 
                                       VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtDetailProtocol" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResFldPort}}" 
                                       VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtDetailPort" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResFldUsername}}" 
                                       VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtDetailUsername" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,12"/>
                        <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResRdpSettings}}" 
                                   FontWeight="SemiBold" Margin="0,8,0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResFldResolution}}" 
                                       VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtDetailResolution" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResFldColorDepth}}" 
                                       VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtDetailColorDepth" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResFldGateway}}" 
                                       VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtDetailGateway" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,12"/>
                        <TextBlock Text="{DynamicResource {x:Static local:TemplateManagementWindow.ResRedirectSettings}}" 
                                   FontWeight="SemiBold" Margin="0,8,0,8"/>

                        <StackPanel x:Name="PanelRedirects" Margin="0,4">
                            <CheckBox x:Name="ChkDetailDrives" Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResRedirectDrives}}" IsEnabled="False" Margin="0,2"/>
                            <CheckBox x:Name="ChkDetailAudio" Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResRedirectAudio}}" IsEnabled="False" Margin="0,2"/>
                            <CheckBox x:Name="ChkDetailClipboard" Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResRedirectClipboard}}" IsEnabled="False" Margin="0,2"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部按钮区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnNew" Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResBtnNew}}" 
                    Width="80" Height="28" Margin="0,0,8,0" Click="BtnNew_Click"/>
            <Button x:Name="BtnEdit" Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResBtnEdit}}" 
                    Width="80" Height="28" Margin="0,0,8,0" Click="BtnEdit_Click" IsEnabled="False"/>
            <Button x:Name="BtnCopy" Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResBtnCopy}}" 
                    Width="80" Height="28" Margin="0,0,8,0" Click="BtnCopy_Click" IsEnabled="False"/>
            <Button x:Name="BtnDelete" Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResBtnDelete}}" 
                    Width="80" Height="28" Margin="0,0,8,0" Click="BtnDelete_Click" IsEnabled="False"/>
            <Button Content="{DynamicResource {x:Static local:TemplateManagementWindow.ResBtnClose}}" 
                    Width="80" Height="28" IsCancel="True" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>

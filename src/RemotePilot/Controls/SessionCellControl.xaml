<UserControl x:Class="RemotePilot.Controls.SessionCellControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RemotePilot.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400"
             Focusable="False"
             IsTabStop="False"
             MouseDown="UserControl_MouseDown">
    <Grid>
        <!-- 容器外边框：聚焦时强调蓝色边框高亮 -->
        <Border x:Name="CellOuterBorder"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="4"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部紧凑标题栏 -->
                <Border Grid.Row="0"
                        x:Name="HeaderBorder"
                        Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,0"
                        MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：协议徽章与状态红绿指示 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 协议徽章 -->
                            <Border x:Name="ProtocolBadge" Background="{DynamicResource Primary}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtProtocol" Text="SSH" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <!-- 状态红绿指示灯 -->
                            <Ellipse x:Name="IndicatorStatus" Width="8" Height="8" Fill="{DynamicResource Success}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 中间：资产名称与主机IP -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0" ClipToBounds="True">
                            <TextBlock x:Name="TxtAssetName" Text="Web-Server-01" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtHostPort" Text=" (192.168.1.100:22)" FontSize="11" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- 右侧操作栏：最大化/还原、关闭按钮 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnMaximizeRestore" Content="🗖" ToolTip="{DynamicResource {x:Static local:SessionCellControl.ResTipMaximize}}" 
                                    Style="{StaticResource ModernButtonStyle}" Padding="5,1" Margin="0,0,4,0" FontSize="10" 
                                    Click="BtnMaximizeRestore_Click"/>
                            <Button x:Name="BtnClose" Content="✕" ToolTip="{DynamicResource {x:Static local:SessionCellControl.ResTipClose}}" 
                                    Style="{StaticResource ModernButtonStyle}" Padding="5,1" FontSize="10" 
                                    Foreground="{DynamicResource Danger}" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 中央内容承载区 (SSH 终端 WebView2 或 RDP 嵌入/占位) -->
                <Grid Grid.Row="1" x:Name="ContentHost" Background="#1E1E1E">
                    <!-- 动态嵌入视图元素 -->
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

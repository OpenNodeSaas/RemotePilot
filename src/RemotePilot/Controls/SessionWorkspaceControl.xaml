<UserControl x:Class="RemotePilot.Controls.SessionWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RemotePilot.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource AppBackground}">
    <UserControl.Resources>
        <local:TabBgConverter x:Key="TabBgConverter"/>
        <local:BrushConverterProxy x:Key="BrushConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部 Tab 标签页管理栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 活动会话 Tab 列表 -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsTabs">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsFocused, Converter={StaticResource TabBgConverter}}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4,4,0,0"
                                        Padding="10,4,8,4" Margin="2,0" Cursor="Hand"
                                        MouseLeftButtonDown="TabItem_MouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusColorBrushKey, Converter={StaticResource BrushConverter}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="✕" Style="{StaticResource ModernButtonStyle}" Width="16" Height="16" Padding="0" FontSize="9"
                                                Foreground="{DynamicResource MutedForeground}" Click="TabClose_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 批量关闭 / 全部关闭操作 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Button x:Name="BtnCloseAll" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayoutCloseAll}}" Style="{StaticResource ModernButtonStyle}" Padding="8,4" Margin="4,0" Click="BtnCloseAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 工作台工具栏：布局切换、适应窗口/原始尺寸、全屏、连接抽屉、断开 -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：布局切换按钮组 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayoutLabel}}" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource MutedForeground}" FontWeight="SemiBold"/>
                    <Button x:Name="BtnLayoutSingle" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayoutSingle}}" Style="{StaticResource ModernButtonStyle}" Margin="3,0" Padding="8,3" Click="BtnLayoutSingle_Click"/>
                    <Button x:Name="BtnLayout1x2" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayout1x2}}" Style="{StaticResource ModernButtonStyle}" Margin="3,0" Padding="8,3" Click="BtnLayout1x2_Click"/>
                    <Button x:Name="BtnLayout2x1" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayout2x1}}" Style="{StaticResource ModernButtonStyle}" Margin="3,0" Padding="8,3" Click="BtnLayout2x1_Click"/>
                    <Button x:Name="BtnLayout2x2" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayout2x2}}" Style="{StaticResource ModernButtonStyle}" Margin="3,0" Padding="8,3" Click="BtnLayout2x2_Click"/>
                    <Button x:Name="BtnLayout2x3" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayout2x3}}" Style="{StaticResource ModernButtonStyle}" Margin="3,0" Padding="8,3" Click="BtnLayout2x3_Click"/>
                    <Button x:Name="BtnLayout3x3" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayout3x3}}" Style="{StaticResource ModernButtonStyle}" Margin="3,0" Padding="8,3" Click="BtnLayout3x3_Click"/>
                </StackPanel>

                <!-- 右侧：工具快捷键 (全屏、断开、连接抽屉) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnFitWindow" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayoutFit}}" Style="{StaticResource ModernButtonStyle}" Margin="3,0" Padding="8,3" Click="BtnFitWindow_Click"/>
                    <Button x:Name="BtnFullscreen" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayoutFullscreen}}" Style="{StaticResource ModernButtonStyle}" Margin="3,0" Padding="8,3" Click="BtnFullscreen_Click"/>
                    <Button x:Name="BtnSettingsDrawer" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayoutConfig}}" Style="{StaticResource ModernButtonStyle}" Margin="3,0" Padding="8,3" Foreground="{DynamicResource Primary}" Click="BtnSettingsDrawer_Click"/>
                    <Button x:Name="BtnDisconnectActive" Content="{DynamicResource {x:Static local:SessionWorkspaceControl.ResLayoutDisconnect}}" Style="{StaticResource ModernButtonStyle}" Margin="8,0,3,0" Padding="8,3" Foreground="{DynamicResource Danger}" Click="BtnDisconnectActive_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. 中央多路分屏容器 (MultiSessionGrid) -->
        <Grid Grid.Row="2" x:Name="GridMultiContainer" Background="{DynamicResource AppBackground}">
            <!-- 动态生成 UniformGrid 单元格 -->
        </Grid>
    </Grid>
</UserControl>

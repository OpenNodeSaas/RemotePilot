<Window x:Class="RemotePilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemotePilot"
        xmlns:svc="clr-namespace:RemotePilot.Services"
        xmlns:controls="clr-namespace:RemotePilot.Controls"
        mc:Ignorable="d"
        Title="{DynamicResource {x:Static local:MainWindow.ResAppTitle}}" Icon="Assets/logo.png" Height="780" Width="1360" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppForeground}">
    
    <Window.Resources>
        <!-- 到期高亮样式：琥珀色预警；选中态（浅蓝底 + 左侧主色竖条）优先于预警色 -->
        <Style x:Key="ExpiryRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- 沿用默认模板的单元格/行细节/行头结构，保持观感一致 -->
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <SelectiveScrollingGrid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </SelectiveScrollingGrid.RowDefinitions>

                                    <DataGridCellsPresenter Grid.Column="1"
                                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                                    <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1"
                                                              Visibility="{TemplateBinding DetailsVisibility}"
                                                              SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=AreRowDetailsFrozen, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}}"/>

                                    <DataGridRowHeader Grid.RowSpan="2"
                                                       SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                                       Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=HeadersVisibility, Converter={x:Static DataGrid.HeadersVisibilityConverter}, ConverterParameter={x:Static DataGridHeadersVisibility.Row}}"/>
                                </SelectiveScrollingGrid>

                                <!-- 选中态左侧主色竖条 -->
                                <Border x:Name="SelectionBar" Width="3" HorizontalAlignment="Left"
                                        Background="Transparent" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBar" Property="Background" Value="{DynamicResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowAlternate}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsExpiredOrNear}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ExpiryRowWarnBackground}"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColLeftNav" Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ColDetailsPanel" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧紧凑导航栏 -->
        <Border x:Name="BorderLeftNav" Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" MouseEnter="BorderLeftNav_MouseEnter" MouseLeave="BorderLeftNav_MouseLeave">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo 与标题 + 折叠/展开按钮 -->
                <Grid Grid.Row="0" Margin="10,0">
                    <StackPanel x:Name="PanelLogoRow" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Image Source="Assets/logo.png" Width="32" Height="32" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel x:Name="PanelLogoText" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RemotePilot" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AppForeground}"/>
                            <TextBlock Text="RemoteOps v2.0" FontSize="10" Foreground="{DynamicResource MutedForeground}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="BtnToggleLeftNav" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernButtonStyle}" Padding="6,4" Background="Transparent" BorderThickness="0" Click="BtnToggleLeftNav_Click">
                        <Grid>
                            <TextBlock x:Name="TxtLeftNavGlyphCollapse" Text="{DynamicResource {x:Static local:MainWindow.ResBtnToggleLeftNav}}"/>
                            <TextBlock x:Name="TxtLeftNavGlyphExpand" Text="{DynamicResource {x:Static local:MainWindow.ResBtnToggleLeftNavExpand}}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </Grid>

                <!-- 导航菜单列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,14">
                        <Button x:Name="NavBtnAssets" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,7" Padding="14,14" Background="Transparent" BorderThickness="0" Click="NavBtnAssets_Click">
                            <Grid>
                                <TextBlock Text="🗂" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavAssetsLabel" Text="{DynamicResource {x:Static local:MainWindow.ResNavAssets}}" Margin="26,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="NavBtnSessions" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,7" Padding="14,14" Background="Transparent" BorderThickness="0" Click="NavBtnSessions_Click">
                            <Grid>
                                <TextBlock Text="🖥" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavSessionsLabel" Text="{DynamicResource {x:Static local:MainWindow.ResNavSessions}}" Margin="26,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="NavBtnFavorites" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,7" Padding="14,14" Background="Transparent" BorderThickness="0" Click="NavBtnFavorites_Click">
                            <Grid>
                                <TextBlock Text="⭐" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavFavoritesLabel" Text="{DynamicResource {x:Static local:MainWindow.ResNavFavorites}}" Margin="26,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="NavBtnRecent" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,7" Padding="14,14" Background="Transparent" BorderThickness="0" Click="NavBtnRecent_Click">
                            <Grid>
                                <TextBlock Text="🕘" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavRecentLabel" Text="{DynamicResource {x:Static local:MainWindow.ResNavRecent}}" Margin="26,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 服务器分组：可展开，展开后在下方直接列出现有分组 -->
                        <Button x:Name="NavBtnGroups" AutomationProperties.Name="{DynamicResource {x:Static local:MainWindow.ResNavGroups}}" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,7" Padding="14,14" Background="Transparent" BorderThickness="0" Click="NavBtnGroups_Click">
                            <Grid>
                                <TextBlock Text="📁" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavGroupsLabel" Text="{DynamicResource {x:Static local:MainWindow.ResNavGroups}}" Margin="26,0,20,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavGroupsChevron" Text="▸" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="PanelNavGroups" Margin="22,0,6,4" Visibility="Collapsed"/>

                        <Button x:Name="NavBtnTemplates" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,7" Padding="14,14" Background="Transparent" BorderThickness="0" Click="NavBtnTemplates_Click">
                            <Grid>
                                <TextBlock Text="🧩" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavTemplatesLabel" Text="{DynamicResource {x:Static local:MainWindow.ResNavTemplates}}" Margin="26,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavBtnHelp" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,7" Padding="14,14" Background="Transparent" BorderThickness="0" Click="NavBtnHelp_Click">
                            <Grid>
                                <TextBlock Text="📖" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavHelpLabel" Text="{DynamicResource {x:Static local:MainWindow.ResNavHelp}}" Margin="26,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button x:Name="NavBtnSettings" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,7" Padding="14,14" Background="Transparent" BorderThickness="0" Click="NavBtnSettings_Click">
                            <Grid>
                                <TextBlock Text="⚙" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavSettingsLabel" Text="{DynamicResource {x:Static local:MainWindow.ResNavSettings}}" Margin="26,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="8,16"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- 底部主题与语言快捷切换按钮 -->
                <StackPanel x:Name="PanelNavBottom" Grid.Row="2" Margin="10" Orientation="Vertical">
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button x:Name="BtnToggleTheme" Content="{DynamicResource {x:Static local:MainWindow.ResThemeToggle}}" Style="{StaticResource ModernButtonStyle}" Margin="2" Padding="6,4" Click="BtnToggleTheme_Click"/>
                        <Button x:Name="BtnToggleLang" Content="{DynamicResource {x:Static local:MainWindow.ResLangToggle}}" Style="{StaticResource ModernButtonStyle}" Margin="2" Padding="6,4" Click="BtnToggleLang_Click"/>
                    </UniformGrid>
                    <Button x:Name="BtnFeedback" Content="{DynamicResource {x:Static local:MainWindow.ResNavFeedback}}" Style="{StaticResource ModernButtonStyle}" Margin="2,0,2,0" Padding="6,6" Click="BtnFeedback_Click" ToolTip="remotemate@protonmail.com&#10;https://github.com/OpenNodeSaas/RemotePilot"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中央主工作区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RowTopCommand" Height="56"/>
                <RowDefinition x:Name="RowTopSettings" Height="Auto"/>
                <RowDefinition x:Name="RowTopGroup" Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部主命令栏 (含全局搜索 Ctrl+K、新增资产、更多操作等) -->
            <Border x:Name="BorderTopCommand" Grid.Row="0" Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 全局搜索框 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="TxtSearchKeyword" Width="260" Style="{StaticResource ModernTextBoxStyle}" KeyUp="TxtSearchKeyword_KeyUp"/>
                        <Button x:Name="BtnSearch" Content="{DynamicResource {x:Static local:MainWindow.ResBtnSearch}}" Style="{StaticResource ModernButtonStyle}" Margin="6,0,0,0" Click="BtnSearch_Click"/>
                        <Button x:Name="BtnShowAll" Content="{DynamicResource {x:Static local:MainWindow.ResBtnShowAll}}" Style="{StaticResource ModernButtonStyle}" Margin="6,0,0,0" Click="BtnShowAll_Click"/>
                    </StackPanel>

                    <!-- 快捷操作按钮组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                            <Button x:Name="BtnViewTable" Content="{DynamicResource {x:Static local:MainWindow.ResBtnViewTable}}" Style="{StaticResource ModernButtonStyle}" Padding="8,4" Background="{DynamicResource Primary}" Foreground="White" Click="BtnViewTable_Click"/>
                            <Button x:Name="BtnViewGrid" Content="{DynamicResource {x:Static local:MainWindow.ResBtnViewGrid}}" Style="{StaticResource ModernButtonStyle}" Padding="8,4" Click="BtnViewGrid_Click"/>
                        </StackPanel>
                        <Button x:Name="BtnColumnSettings" Content="{DynamicResource {x:Static local:MainWindow.ResBtnColumnSettings}}" Style="{StaticResource ModernButtonStyle}" Margin="4,0" Padding="8,4" Click="BtnColumnSettings_Click"/>
                        <Button x:Name="BtnAddServer" Content="{DynamicResource {x:Static local:MainWindow.ResBtnAddServer}}" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0" Click="BtnAddServer_Click"/>
                        <Button x:Name="BtnOpen" Content="{DynamicResource {x:Static local:MainWindow.ResBtnOpen}}" Style="{StaticResource ModernButtonStyle}" Margin="4,0" FontWeight="Bold" Foreground="{DynamicResource Primary}" Click="BtnOpen_Click"/>
                        <Button x:Name="BtnImport" Content="{DynamicResource {x:Static local:MainWindow.ResBtnImport}}" Style="{StaticResource ModernButtonStyle}" Margin="4,0" Click="BtnImport_Click"/>
                        <Button x:Name="BtnExportSelected" Content="{DynamicResource {x:Static local:MainWindow.ResBtnExportSelected}}" Style="{StaticResource ModernButtonStyle}" Margin="4,0" Click="BtnExportSelected_Click"/>
                        <Button x:Name="BtnInvertSelect" Content="{DynamicResource {x:Static local:MainWindow.ResBtnInvertSelect}}" Style="{StaticResource ModernButtonStyle}" Margin="4,0" Click="BtnInvertSelect_Click"/>
                        <TextBlock x:Name="TxtSelectedCount" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedForeground}"/>
                        <Button x:Name="BtnDelete" Content="{DynamicResource {x:Static local:MainWindow.ResBtnDelete}}" Style="{StaticResource ModernButtonStyle}" Margin="4,0" Click="BtnDelete_Click"/>
                        <Button x:Name="BtnSyncCloud" Content="{DynamicResource {x:Static local:MainWindow.ResBtnSyncCloud}}" Style="{StaticResource ModernButtonStyle}" Margin="4,0" Click="BtnSyncCloud_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 列设置浮层：列显隐 / 顺序 / 字号 -->
            <Popup x:Name="PopupColumnSettings" Grid.Row="0" PlacementTarget="{Binding ElementName=BtnColumnSettings}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Width="280">
                        <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResColSettingsTitle}}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResColSettingsHint}}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResColSettingsFontSize}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbListFontSize" Width="140" SelectionChanged="CmbListFontSize_SelectionChanged"/>
                        </StackPanel>
                        <Separator Margin="0,0,0,8"/>
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PanelColumnToggles"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 第二行工具栏：窗口模式与设备重定向控制 -->
            <Border x:Name="BorderTopSettings" Grid.Row="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResSettingWindowMode}}" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{DynamicResource MutedForeground}"/>
                    <RadioButton x:Name="RbModeNormal" Content="{DynamicResource {x:Static local:MainWindow.ResSettingModeNormal}}" VerticalAlignment="Center" Margin="4,0" IsChecked="True" Foreground="{DynamicResource AppForeground}"/>
                    <RadioButton x:Name="RbModeFullscreen" Content="{DynamicResource {x:Static local:MainWindow.ResSettingModeFullscreen}}" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource AppForeground}"/>
                    <RadioButton x:Name="RbModeSmall" Content="{DynamicResource {x:Static local:MainWindow.ResSettingModeSmall}}" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource AppForeground}"/>
                    <RadioButton x:Name="RbModeTab" Content="{DynamicResource {x:Static local:MainWindow.ResSettingModeTab}}" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource AppForeground}"/>
                    
                    <Separator Margin="10,0" Background="{DynamicResource BorderBrush}"/>
                    
                    <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResSettingDeviceControl}}" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{DynamicResource MutedForeground}"/>
                    <CheckBox x:Name="ChkDriveMap" Content="{DynamicResource {x:Static local:MainWindow.ResSettingDriveMap}}" ToolTip="{DynamicResource {x:Static local:MainWindow.ResTipDeviceRedirect}}" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource AppForeground}"/>
                    <CheckBox x:Name="ChkAudio" Content="{DynamicResource {x:Static local:MainWindow.ResSettingAudio}}" ToolTip="{DynamicResource {x:Static local:MainWindow.ResTipDeviceRedirect}}" VerticalAlignment="Center" Margin="4,0" IsChecked="True" Foreground="{DynamicResource AppForeground}"/>
                    <CheckBox x:Name="ChkClipboard" Content="{DynamicResource {x:Static local:MainWindow.ResSettingClipboard}}" ToolTip="{DynamicResource {x:Static local:MainWindow.ResTipDeviceRedirect}}" VerticalAlignment="Center" Margin="4,0" IsChecked="True" Foreground="{DynamicResource AppForeground}"/>
                    
                    <Separator Margin="10,0" Background="{DynamicResource BorderBrush}"/>
                    
                    <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResSettingColorDepth}}" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{DynamicResource MutedForeground}"/>
                    <ComboBox x:Name="CmbColorDepth" Width="85" VerticalAlignment="Center" SelectedIndex="4" Margin="4,0">
                        <ComboBoxItem Tag="8" Content="{DynamicResource {x:Static local:MainWindow.ResSettingBit8}}"/>
                        <ComboBoxItem Tag="15" Content="{DynamicResource {x:Static local:MainWindow.ResSettingBit15}}"/>
                        <ComboBoxItem Tag="16" Content="{DynamicResource {x:Static local:MainWindow.ResSettingBit16}}"/>
                        <ComboBoxItem Tag="24" Content="{DynamicResource {x:Static local:MainWindow.ResSettingBit24}}"/>
                        <ComboBoxItem Tag="32" Content="{DynamicResource {x:Static local:MainWindow.ResSettingBit32}}"/>
                    </ComboBox>
                    
                    <Button x:Name="BtnProbe" Content="{DynamicResource {x:Static local:MainWindow.ResBtnProbe}}" Style="{StaticResource ModernButtonStyle}" Margin="10,0,4,0" Padding="8,3" Click="BtnProbe_Click"/>
                </WrapPanel>
            </Border>

            <!-- 第三行：分组统计徽章行与临期预警摘要条 -->
            <Border x:Name="BorderTopGroup" Grid.Row="2" Background="{DynamicResource AppBackground}" Padding="10,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel x:Name="PanelGroupBadges" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnBatchProbe" Content="{DynamicResource {x:Static local:MainWindow.ResBtnBatchProbe}}" Style="{StaticResource ModernButtonStyle}" Padding="10,4" Margin="4,0" Click="BtnBatchProbe_Click"/>
                        <Button x:Name="BtnExpirySummaryBanner" Content="{DynamicResource {x:Static local:MainWindow.ResBtnExpiryBanner}}" Style="{StaticResource ModernButtonStyle}" Background="#FFFBE6" Foreground="#B06000" Padding="10,4" Margin="4,0" Visibility="Collapsed" Click="BtnExpirySummaryBanner_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 中央资产 DataGrid / 会话工作台切换内容区 -->
            <Grid Grid.Row="3" x:Name="GridContentArea">
                <DataGrid x:Name="GridAssets" AutoGenerateColumns="False" CanUserAddRows="False" 
                          CanUserSortColumns="True"
                          RowStyle="{StaticResource ExpiryRowStyle}" SelectionMode="Extended"
                          Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource AppForeground}"
                          BorderBrush="{DynamicResource BorderBrush}" MouseDoubleClick="GridAssets_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="GridAssets_PreviewMouseLeftButtonDown"
                          SelectionChanged="GridAssets_SelectionChanged"
                          AlternationCount="2"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="ColFavorite" Header="{Binding [Col_Favorite], Source={x:Static svc:LocalizationManager.Instance}}" Width="56" SortMemberPath="IsFavorite">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}" Background="Transparent" BorderThickness="0"
                                            FontSize="16" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                            ToolTip="{DynamicResource {x:Static local:MainWindow.ResTipFavorite}}" Click="BtnFavoriteRow_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 选择列：表头为三态复选框（全选/半选/全不选当前可见行），单元格双向绑定 IsSelected -->
                        <DataGridTemplateColumn x:Name="ColSelect" Width="50" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="ChkSelectAllHeader_Click"
                                          ToolTip="{Binding [Col_Select], Source={x:Static svc:LocalizationManager.Instance}}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColGroup" Header="{Binding [Col_Group], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding Group}" Width="90" IsReadOnly="True"/>
                        
                        <DataGridTextColumn x:Name="ColOwner" Header="{Binding [Col_Owner], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding Owner}" Width="80" IsReadOnly="True"/>
                        
                        <DataGridTextColumn x:Name="ColName" Header="{Binding [Col_Name], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding Name}" Width="150" IsReadOnly="True" SortMemberPath="Name"/>

                        <DataGridTemplateColumn x:Name="ColIpPort" Header="{Binding [Col_IpPort], Source={x:Static svc:LocalizationManager.Instance}}" Width="160" SortMemberPath="IpPortDisplay">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IpPortDisplay}" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" Margin="2,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn x:Name="ColUsername" Header="{Binding [Col_Username], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding Username}" Width="90" IsReadOnly="True"/>
                        
                        <!-- 状态带颜色标签 -->
                        <DataGridTemplateColumn x:Name="ColStatus" Header="{Binding [Col_Status], Source={x:Static svc:LocalizationManager.Instance}}" Width="90" SortMemberPath="StatusKind">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBadgeBackground}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            ToolTip="{Binding [Tip_StatusNotProbed], Source={x:Static svc:LocalizationManager.Instance}}">
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusBadgeForeground}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn x:Name="ColExpiresOn" Header="{Binding [Col_ExpiresOn], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding ExpiresOnDisplay}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn x:Name="ColNote1" Header="{Binding [Col_Note1], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding CustomNote1}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn x:Name="ColNote2" Header="{Binding [Col_Note2], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding CustomNote2}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn x:Name="ColNote3" Header="{Binding [Col_Note3], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding CustomNote3}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn x:Name="ColNote4" Header="{Binding [Col_Note4], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding CustomNote4}" Width="100" IsReadOnly="True"/>

                        <!-- 模板列：可点击打开连接方案抽屉 -->
                        <DataGridTemplateColumn x:Name="ColTemplate" Header="{Binding [Col_Template], Source={x:Static svc:LocalizationManager.Instance}}" Width="100" SortMemberPath="TemplateName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding TemplateName}"
                                            Tag="{Binding}"
                                            Click="BtnTemplateName_Click"
                                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,2"
                                            HorizontalAlignment="Left"
                                            Cursor="Hand"
                                            Foreground="{DynamicResource Primary}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                          TextDecorations="Underline"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          VerticalAlignment="Center"
                                                          Padding="{TemplateBinding Padding}"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn x:Name="ColProtocol" Header="{Binding [Col_Protocol], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding Protocol}" Width="60" IsReadOnly="True"/>

                        <!-- 操作列固定放在最后 -->
                        <DataGridTemplateColumn x:Name="ColAction" Header="{Binding [Col_Action], Source={x:Static svc:LocalizationManager.Instance}}" Width="100" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnEdit}}" Margin="2,0" Padding="4,2" Style="{StaticResource ModernButtonStyle}" Click="BtnEditRow_Click" Tag="{Binding}"/>
                                        <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnRemove}}" Margin="2,0" Padding="4,2" Style="{StaticResource ModernButtonStyle}" Click="BtnDeleteRow_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 宫格卡片视图 (Cards Grid) -->
                <ScrollViewer x:Name="ScrollCardsArea" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBackground}" Visibility="Collapsed">
                    <ItemsControl x:Name="ItemsCardsGrid" Margin="16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="280" Height="170" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="8" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 第一行：名称与状态徽章 -->
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppForeground}" TextTrimming="CharacterEllipsis" Width="180" HorizontalAlignment="Left"/>
                                            <Border Background="{Binding StatusBadgeBackground}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusBadgeForeground}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <!-- 第二行：IP端口与协议 -->
                                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding IpPortDisplay}" FontSize="12" Foreground="{DynamicResource Primary}" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}" Background="Transparent" BorderThickness="0"
                                                        FontSize="13" Padding="0" Margin="0,0,6,0" Cursor="Hand" ToolTip="{DynamicResource {x:Static local:MainWindow.ResTipFavorite}}"
                                                        Click="BtnFavoriteRow_Click" Tag="{Binding}"/>
                                                <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 第三行：负责人与到期日 -->
                                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResCardOwner}}" FontSize="11" Foreground="{DynamicResource MutedForeground}"/>
                                                <TextBlock Text="{Binding Owner}" FontSize="11" Foreground="{DynamicResource AppForeground}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResCardExpires}}" FontSize="11" Foreground="{DynamicResource MutedForeground}"/>
                                                <TextBlock Text="{Binding ExpiresOnDisplay}" FontSize="11" Foreground="{DynamicResource AppForeground}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 第四行：快速连接与编辑按钮 -->
                                        <Grid Grid.Row="3" Margin="0,4,0,0">
                                            <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnQuickConnect}}" Style="{StaticResource PrimaryButtonStyle}" Height="28" HorizontalAlignment="Left" Width="120" Click="BtnCardConnect_Click" Tag="{Binding}"/>
                                            <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnEdit}}" Style="{StaticResource ModernButtonStyle}" Height="28" HorizontalAlignment="Right" Width="70" Click="BtnCardEdit_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 会话工作台面板 (默认隐藏，切换时显示) -->
                <controls:SessionWorkspaceControl x:Name="SessionWorkspace" Visibility="Collapsed"/>

                <!-- 帮助手册 (默认隐藏，切换时显示) -->
                <controls:HelpManualView x:Name="HelpManual" Visibility="Collapsed"/>

                <!-- 设置 (默认隐藏，切换时显示) -->
                <controls:SettingsView x:Name="SettingsView" Visibility="Collapsed"/>

                <!-- 连接方案模板管理 (默认隐藏，切换时显示) -->
                <local:TemplateManagementView x:Name="TemplateManagement" Visibility="Collapsed"/>

                <!-- 侧边浮层抽屉：连接方案配置 (ConnectionSettingsDrawer) -->
                <local:ConnectionSettingsDrawer x:Name="SettingsDrawer" Grid.Column="1" HorizontalAlignment="Right" Width="420" Margin="0,0,0,0" Panel.ZIndex="99" Visibility="Collapsed"/>
            </Grid>

            <!-- 底部状态栏 -->
            <StatusBar Grid.Row="4" Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource AppForeground}" Padding="8,4">
                <StatusBarItem>
                    <TextBlock x:Name="TxtStatusBarInfo" Text="{DynamicResource {x:Static local:MainWindow.ResStatusReady}}"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>

        <!-- 右侧按需可折叠详情面板 -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" x:Name="BorderRightPanel" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 详情面板标题与收起按钮 -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid>
                        <TextBlock x:Name="TxtDetailsTitle" Text="{DynamicResource {x:Static local:MainWindow.ResPanelDetails}}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AppForeground}"/>
                        <Button x:Name="BtnToggleDetails" Content="{DynamicResource {x:Static local:MainWindow.ResPanelCollapse}}" HorizontalAlignment="Right" Style="{StaticResource ModernButtonStyle}" Padding="6,2" Click="BtnToggleDetails_Click"/>
                    </Grid>
                </Border>

                <!-- 详情内容区 -->
                <ScrollViewer x:Name="DetailsScroll" Grid.Row="1" Padding="14">
                    <StackPanel x:Name="PanelAssetDetailContent">
                        <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResPanelOverview}}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="{DynamicResource Primary}"/>
                        
                        <!-- 选中资产详情：仅保留分辨率快速配置，其余编辑项走资产编辑对话框 -->
                        <StackPanel x:Name="PanelInspectorForm" Visibility="Collapsed">
                            <TextBlock x:Name="InspectorTxtName" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2" Foreground="{DynamicResource AppForeground}"/>
                            <TextBlock x:Name="InspectorTxtTarget" FontSize="11" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <StackPanel x:Name="PanelRdpResolution">
                                <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResSettingResolution}}" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppForeground}"/>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <TextBox x:Name="TxtWidth" Text="1920" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,4,0"/>
                                    <TextBox x:Name="TxtHeight" Text="1080" Style="{StaticResource ModernTextBoxStyle}" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnScreen14}}" Style="{StaticResource ModernButtonStyle}" Margin="2" Click="BtnScreen14_Click"/>
                                    <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnScreen16}}" Style="{StaticResource ModernButtonStyle}" Margin="2" Click="BtnScreen16_Click"/>
                                    <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnScreen19}}" Style="{StaticResource ModernButtonStyle}" Margin="2" Click="BtnScreen19_Click"/>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnSplitH}}" Style="{StaticResource ModernButtonStyle}" Margin="2" Click="BtnSplitH_Click"/>
                                    <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnSplitV}}" Style="{StaticResource ModernButtonStyle}" Margin="2" Click="BtnSplitV_Click"/>
                                </UniformGrid>
                                <Button Content="{DynamicResource {x:Static local:MainWindow.ResBtnResetResolution}}" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,16" Click="BtnResetResolution_Click"/>
                            </StackPanel>

                            <!-- 到期预警与最后检测耗时状态卡片 -->
                            <Border Background="{DynamicResource SidebarBackground}" CornerRadius="4" Padding="10" Margin="0,4,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResInspExpiryWarn}}" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                                        <TextBlock x:Name="InspectorTxtExpiryWarning" Foreground="{DynamicResource Success}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResInspLastProbe}}" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                                        <TextBlock x:Name="InspectorTxtProbeDuration" Text="-" Foreground="{DynamicResource MutedForeground}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="InspectorPlaceholder" Text="{DynamicResource {x:Static local:MainWindow.ResInspPlaceholder}}" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <!-- 就地连接/探测失败错误提示与检查建议 -->
                        <Border x:Name="BorderConnectionErrorHint" Background="#FCE8E6" BorderBrush="#C5221F" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResDiagTitle}}" FontWeight="Bold" Foreground="#C5221F"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtErrorReason" Text="{DynamicResource {x:Static local:MainWindow.ResDiagReason}}" TextWrapping="Wrap" FontSize="12" Foreground="#3C4043" Margin="0,0,0,6"/>
                                <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResDiagAdvice}}" FontWeight="SemiBold" FontSize="11" Foreground="#202124"/>
                                <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResDiagAdviceDetail}}" FontSize="11" Foreground="#5F6368" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <UniformGrid Columns="1">
                                    <Button x:Name="BtnRetryConnection" Content="{DynamicResource {x:Static local:MainWindow.ResDiagRetry}}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,0" Click="BtnRetryConnection_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResSettingProbeInterval}}" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppForeground}"/>
                        <TextBox x:Name="TxtProbeInterval" Text="0" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16" TextChanged="TxtProbeInterval_TextChanged"/>

                        <CheckBox x:Name="ChkRememberPassword" Content="{DynamicResource {x:Static local:MainWindow.ResSettingRememberPassword}}" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppForeground}" Checked="ChkRememberPassword_Changed" Unchecked="ChkRememberPassword_Changed"/>
                        <TextBlock Text="{DynamicResource {x:Static local:MainWindow.ResSettingRememberPasswordHint}}" FontSize="11" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 快捷保存 -->
                <Border x:Name="DetailsFooter" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                    <Button x:Name="BtnSaveSettings" Content="{DynamicResource {x:Static local:MainWindow.ResBtnSaveSettings}}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="BtnSaveSettings_Click"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

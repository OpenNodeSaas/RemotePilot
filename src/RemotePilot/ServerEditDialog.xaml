<Window x:Class="RemotePilot.ServerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemotePilot"
        Title="{DynamicResource {x:Static local:ServerEditDialog.ResDlgTitle}}" Height="560" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResDlgHeader}}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldName}}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtName" Grid.Column="1" Padding="4"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldGroup}}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbGroup" Grid.Column="1" Padding="4" IsEditable="True"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldHost}}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHost" Grid.Column="1" Padding="4"/>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldPort}}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtPort" Grid.Column="3" Text="3389" Padding="4"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldProtocol}}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbProtocol" Grid.Column="1" SelectedIndex="0" SelectionChanged="CmbProtocol_SelectionChanged">
                        <ComboBoxItem Content="rdp"/>
                        <ComboBoxItem Content="ssh"/>
                    </ComboBox>
                </Grid>

                <Grid x:Name="RowTemplate" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldTemplate}}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbTemplate" Grid.Column="1" Padding="4"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldUsername}}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtUsername" Grid.Column="1" Padding="4"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldPassword}}" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="TxtPassword" Grid.Column="1" Padding="4"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkRememberPassword" Grid.Column="1" Content="{DynamicResource {x:Static local:ServerEditDialog.ResFldRememberPassword}}" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel x:Name="PanelServerSshFields" Visibility="Collapsed">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldKeyPath}}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSshKeyPath" Padding="4"/>
                            <Button Grid.Column="1" Content="{DynamicResource {x:Static local:ServerEditDialog.ResBtnBrowse}}" Margin="4,0,0,0" Click="BtnBrowseKey_Click"/>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldPassphrase}}" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="TxtKeyPassphrase" Grid.Column="1" Padding="4"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldJumpHost}}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbJumpHost" Grid.Column="1" Padding="4"/>
                    </Grid>
                </StackPanel>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldOwner}}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtOwner" Grid.Column="1" Padding="4"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldExpiresOn}}" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DpExpiresOn" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldNote1}}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtNote1" Grid.Column="1" Padding="4"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldNote2}}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtNote2" Grid.Column="1" Padding="4"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResFldNote3}}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtNote3" Grid.Column="1" Padding="4"/>
                </Grid>

                <StackPanel x:Name="PanelRdpRedirect">
                    <TextBlock Text="{DynamicResource {x:Static local:ServerEditDialog.ResRdpRedirect}}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <WrapPanel Margin="0,2">
                        <CheckBox x:Name="ChkRedirectDrives" Content="{DynamicResource {x:Static local:ServerEditDialog.ResDriveMap}}" Margin="0,0,10,0"/>
                        <CheckBox x:Name="ChkRedirectAudio" Content="{DynamicResource {x:Static local:ServerEditDialog.ResAudio}}" Margin="0,0,10,0" IsChecked="True"/>
                        <CheckBox x:Name="ChkRedirectClipboard" Content="{DynamicResource {x:Static local:ServerEditDialog.ResClipboard}}" Margin="0,0,10,0"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource {x:Static local:ServerEditDialog.ResBtnOk}}" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="{DynamicResource {x:Static local:ServerEditDialog.ResBtnCancel}}" Width="80" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

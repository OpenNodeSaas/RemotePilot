<Window x:Class="RemotePilot.FastRdpSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemotePilot"
        xmlns:svc="clr-namespace:RemotePilot.Services"
        Title="{DynamicResource {x:Static local:FastRdpSyncDialog.ResSyncTitle}}" Height="480" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource {x:Static local:FastRdpSyncDialog.ResSyncHeader}}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource {x:Static local:FastRdpSyncDialog.ResSyncDesc}}" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource {x:Static local:FastRdpSyncDialog.ResSyncBaseUrl}}" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtBaseUrl" Grid.Column="1" Padding="4" Text="https://"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource {x:Static local:FastRdpSyncDialog.ResSyncToken}}" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtToken" Grid.Column="1" Padding="4"/>
            </Grid>

            <!-- 资产预览列表 -->
            <TextBlock Text="{DynamicResource {x:Static local:FastRdpSyncDialog.ResSyncPreview}}" Margin="0,10,0,4" FontWeight="SemiBold"/>
            <DataGrid x:Name="GridPreview" Height="150" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{Binding [Sync_ColImport], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="{Binding [Sync_ColName], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding Name}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{Binding [Sync_ColHost], Source={x:Static svc:LocalizationManager.Instance}}" Binding="{Binding Host}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="TxtStatus" Foreground="#007ACC" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSync" Content="{DynamicResource {x:Static local:FastRdpSyncDialog.ResSyncBtnSync}}" Width="110" Height="28" Margin="0,0,8,0" IsDefault="True" Click="BtnSync_Click"/>
            <Button Content="{DynamicResource {x:Static local:FastRdpSyncDialog.ResBtnCancel}}" Width="70" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
